             "$ref": "#/components/schemas/AdminConfigLibraryScanDto"
           },
@@ -19533,6 +19603,7 @@
           }
         },
         "required": [
+          "checksum",
           "scan",
           "watch"
         ],
@@ -22136,6 +22207,22 @@
         ],
         "type": "object"
       },
+      "ChecksumAlgorithm": {
