From 9fcd383520d0d9f213fe44292b082318d0744250 Mon Sep 17 00:00:00 2001
From: lunatickochiya <125438787@qq.com>
Date: Sun, 25 Oct 2026 14:08:47 +0800
Subject: [PATCH 3/5] chore(open-api): regenerate spec and TypeScript SDK

Adds AdminConfigLibraryChecksumDto, ChecksumAlgorithm/ChecksumRehashTarget
enums, RecomputeChecksumsDto, the recompute-checksums endpoint and the
LibraryRehash job name.
---
 open-api/immich-openapi-specs.json | 105 +++++++++++++++++++++++++++++
 packages/sdk/src/fetch-client.ts   |  33 +++++++++
 2 files changed, 138 insertions(+)

diff --git a/open-api/immich-openapi-specs.json b/open-api/immich-openapi-specs.json
index fa7a2fe07..4a1f21748 100644
--- a/open-api/immich-openapi-specs.json
+++ b/open-api/immich-openapi-specs.json
@@ -7514,6 +7514,56 @@
         "x-immich-state": "Stable"
       }
     },
+    "/libraries/recompute-checksums": {
+      "post": {
+        "description": "Queue a background job that recomputes asset checksums. External libraries use the configured checksum algorithm, uploads always use the content SHA-1.",
+        "operationId": "recomputeChecksums",
+        "parameters": [],
+        "requestBody": {
+          "content": {
+            "application/json": {
+              "schema": {
+                "$ref": "#/components/schemas/RecomputeChecksumsDto"
