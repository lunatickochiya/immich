+          },
+          {
+            "version": "v3.3.0",
+            "state": "Beta"
+          }
+        ],
+        "x-immich-permission": "library.update",
+        "x-immich-state": "Beta"
+      }
+    },
     "/libraries/{id}": {
       "delete": {
         "description": "Delete an external library by its ID.",
@@ -19523,8 +19573,28 @@
         ],
         "type": "object"
       },
+      "AdminConfigLibraryChecksumDto": {
+        "properties": {
+          "dedupeUploadsAgainstLibraries": {
+            "description": "Treat an upload as a duplicate when an external library asset has the same content checksum",
+            "type": "boolean"
+          },
+          "external": {
+            "$ref": "#/components/schemas/ChecksumAlgorithm",
+            "description": "Checksum algorithm used when importing assets from external libraries"
